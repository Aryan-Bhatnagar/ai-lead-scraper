# AI Lead Scraper CRM - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================
# REQUIRED - Core AI / Ollama Configuration
# ============================================================

# Ollama server URL (must be running locally or on network)
OLLAMA_BASE_URL=http://localhost:11434

# Model for ScrapeGraphAI enrichment (must be pulled in Ollama)
# Format: ollama/<model-name>
SCRAPEGRAPH_MODEL=ollama/llama3.2

# AI Intelligence provider: 'ollama' (default) or 'openai'
AI_INTELLIGENCE_PROVIDER=ollama

# ============================================================
# OPTIONAL - OpenAI (only if AI_INTELLIGENCE_PROVIDER=openai)
# ============================================================

# OpenAI API key (required if using OpenAI provider)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# OPTIONAL - Google Maps / Places API
# ============================================================

# Google Maps API key for Places import (optional)
# GOOGLE_MAPS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# OPTIONAL - Upwork Credentials (for live scraping)
# ============================================================

# Upwork username/email (optional, for live scraping)
# UPWORK_USERNAME=your_email@example.com

# Upwork password (optional, for live scraping)
# UPWORK_PASSWORD=your_password

# ============================================================
# OPTIONAL - Apify (for dataset imports)
# ============================================================

# Apify API token for dataset imports (optional)
# APIFY_TOKEN=apify_xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# OPTIONAL - n8n Outreach Integration
# ============================================================

# n8n webhook URL for outreach dispatch (CRM calls this webhook)
# OUTREACH_WEBHOOK_URL=https://your-n8n-instance/webhook/outreach

# Maximum outreach entries to process per batch
OUTREACH_BATCH_LIMIT=10

# Maximum retry attempts for failed outreach
OUTREACH_MAX_RETRY=3

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# Main SQLite database path
DATABASE=data/leads.db

# Repository database URI (SQLite)
LEAD_REPOSITORY_URI=sqlite:///data/leads_repo.db

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================

# Frontend API base URL (for Vite dev server proxy)
VITE_API_URL=http://localhost:5000

# ============================================================
# DEVELOPMENT / DEBUG
# ============================================================

# Flask debug mode
FLASK_DEBUG=True

# Log level
LOG_LEVEL=INFO